<p><%= @user.full_name.presence || "Hello" %>,</p>

<p>
  <%= @dues.size == 1 ? "One thing in your register is running out." : "#{@dues.size} things in your register are running out." %>
</p>

<table cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;margin:16px 0">
  <% @dues.each do |due| %>
    <tr>
      <td style="padding:10px 0;border-bottom:1px solid #e5e7eb">
        <div style="font-weight:600;color:#1f2937"><%= due.record.title %></div>
        <div style="color:#6b7280;font-size:14px">
          <%= due.field.label %>:
          <span style="font-family:ui-monospace,Menlo,monospace"><%= due.date.strftime("%-d %B %Y") %></span>
          &middot;
          <strong style="color:<%= due.days <= 30 ? "#dc2626" : due.days <= 90 ? "#d97706" : "#6b7280" %>">
            <%= due.days.zero? ? "today" : "#{due.days} days left" %>
          </strong>
        </div>
      </td>
    </tr>
  <% end %>
</table>

<p><a href="<%= @register_url %>">Open your register</a></p>

<p style="color:#9ca3af;font-size:13px">
  You can turn these off in Settings &rarr; Reminders.
</p>
