source "https://rubygems.org"

gem "rails", "~> 8.1.3", ">= 8.1.3.1"
gem "pg", "~> 1.1"
gem "puma", ">= 5.0"
gem "bootsnap", require: false
gem "tzinfo-data", platforms: %i[ windows jruby ]

# --- Auth -------------------------------------------------------------------
gem "bcrypt", "~> 3.1.7"
gem "jwt", "~> 3.1"
gem "omniauth", "~> 2.1"
gem "omniauth-google-oauth2", "~> 1.2"
gem "omniauth-github", "~> 2.0"
gem "omniauth-rails_csrf_protection", "~> 1.0"

# --- Storage ----------------------------------------------------------------
# Active Storage talks S3; MinIO locally, R2/S3 in production.
gem "aws-sdk-s3", "~> 1.180", require: false
gem "image_processing", "~> 1.2"
# Streams ZIP archives entry by entry, so downloading a whole folder never
# buffers the archive in memory or on disk.
gem "zip_kit", "~> 6.3"
gem "ruby-vips", "~> 2.2"

# --- Background jobs --------------------------------------------------------
gem "sidekiq", "~> 8.0"
# Recurring jobs. The Trash screen promises files disappear after 30 days, so
# something has to actually run the purge.
gem "sidekiq-cron", "~> 2.3"
gem "redis", "~> 5.3"

# --- API plumbing -----------------------------------------------------------
gem "rack-cors"
gem "rack-attack"
gem "pagy", "~> 9.3"

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
  gem "bundler-audit", require: false
  gem "brakeman", require: false
  gem "rubocop-rails-omakase", require: false

  gem "rspec-rails", "~> 8.0"
  gem "factory_bot_rails", "~> 6.4"
  gem "faker", "~> 3.5"
  gem "dotenv-rails", "~> 3.1"
end

group :test do
  gem "shoulda-matchers", "~> 6.4"
  gem "simplecov", require: false
  gem "webmock", require: false
end
