# Single front door for CloudVault behind Coolify/Traefik + Cloudflare Tunnel.
# TLS ends at Cloudflare; Rails has assume_ssl on, and we say https explicitly.
{
	auto_https off
	admin off
}

:80 {
	@rails path /api/* /up /rails/*
	handle @rails {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto https
			# Large uploads and streamed downloads: don't cut them off.
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}

	handle {
		reverse_proxy web:80
	}
}
